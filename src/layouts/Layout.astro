---
import '../styles/global.css';
import { type Locale, languages } from '../i18n/ui';
import { useTranslations, getHreflangTags, getRelativeLocaleUrl } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  lang?: Locale;
}

const { lang = 'en', title, description } = Astro.props;
const t = useTranslations(lang);

const siteTitle = title || t('site.title');
const siteDescription = description || t('site.description');
const siteUrl = 'https://browsercut.github.io';
const canonicalUrl = `${siteUrl}${getRelativeLocaleUrl(lang)}`;
const hreflangEntries = getHreflangTags(Astro.url.pathname, siteUrl);
const ogImageUrl = 'https://res.cloudinary.com/dpx6w78bt/image/upload/f_auto/q_auto/v1786342039/Online_Tool_rc1ybr.png';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['WebApplication', 'SoftwareApplication'],
      '@id': `${siteUrl}/#software`,
      name: 'BrowserCut',
      url: siteUrl,
      image: ogImageUrl,
      screenshot: ogImageUrl,
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'Any (Web Browser with WebAssembly)',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      description: t('site.description'),
      featureList: [
        '100% Client-Side WebAssembly Processing',
        'Frame-Accurate Video Trimming',
        'Audio Track Replacement and Mixing',
        'Video and Audio Fade-In and Fade-Out Transitions',
        'Zero Server Uploads and Total Privacy',
        'No Watermarks and No Accounts Required',
      ],
      creator: {
        '@type': 'Person',
        name: 'BrowserCut Contributors',
        url: 'https://buymeacoffee.com/kisharadilz',
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumbs`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${siteUrl}/`,
        },
        ...(lang !== 'en'
          ? [
              {
                '@type': 'ListItem',
                position: 2,
                name: languages[lang]?.name || lang,
                item: canonicalUrl,
              },
            ]
          : [
              {
                '@type': 'ListItem',
                position: 2,
                name: 'Video & Audio Editor',
                item: canonicalUrl,
              },
            ]),
      ],
    },
    {
      '@type': 'HowTo',
      '@id': `${siteUrl}/#howto`,
      name: t('how.title'),
      description: t('how.subtitle'),
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: t('how.step1.title'),
          text: t('how.step1.desc'),
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: t('how.step2.title'),
          text: t('how.step2.desc'),
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: t('how.step3.title'),
          text: t('how.step3.desc'),
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${siteUrl}/#faq`,
      mainEntity: [
        {
          '@type': 'Question',
          name: t('faq.q1'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: t('faq.a1'),
          },
        },
        {
          '@type': 'Question',
          name: t('faq.q2'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: t('faq.a2'),
          },
        },
        {
          '@type': 'Question',
          name: t('faq.q3'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: t('faq.a3'),
          },
        },
        {
          '@type': 'Question',
          name: t('faq.q4'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: t('faq.a4'),
          },
        },
        {
          '@type': 'Question',
          name: t('faq.q5'),
          acceptedAnswer: {
            '@type': 'Answer',
            text: t('faq.a5'),
          },
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang={lang} dir={languages[lang]?.dir || 'ltr'} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- COOP / COEP Service Worker (Required for SharedArrayBuffer on GitHub Pages) -->
    <script is:inline src="/coi-serviceworker.js"></script>

    <!-- Inline Anti-FOUC Theme Script -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var isDark =
            stored === 'dark' ||
            (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (isDark) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Primary Meta Tags -->
    <title>{siteTitle}</title>
    <meta name="title" content={siteTitle} />
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- 7 Bidirectional hreflang tags including x-default -->
    {
      hreflangEntries.map((entry) => (
        <link rel="alternate" hreflang={entry.lang} href={entry.href} />
      ))
    }

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:site_name" content="BrowserCut" />
    <meta property="og:locale" content={lang} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="BrowserCut - Free In-Browser Video and Audio Editor" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="BrowserCut - Free In-Browser Video and Audio Editor" />
    <meta name="twitter:creator" content="@BrowserCut" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="flex flex-col min-h-screen">
    <slot />
  </body>
</html>
