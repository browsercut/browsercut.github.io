---
import { languages, type Locale, defaultLang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  currentLang: Locale;
}

const { currentLang } = Astro.props;
const t = useTranslations(currentLang);
---

<footer class="mt-auto border-t border-pale-blue/60 dark:border-vivid-blue/40 bg-white/60 dark:bg-[#050d28]/80 backdrop-blur-md py-12 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <!-- Brand & Mission -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-vivid-blue to-soft-blue flex items-center justify-center text-white">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.243 4.243 3 3 0 004.243-4.243zm0-5.758a3 3 0 10-4.243-4.243 3 3 0 004.243 4.243z" />
            </svg>
          </div>
          <span class="text-lg font-black text-deep-navy dark:text-white">
            Browser<span class="text-vivid-blue dark:text-soft-blue">Cut</span>
          </span>
        </div>
        <p class="text-sm text-deep-navy/70 dark:text-pale-blue/70 max-w-sm leading-relaxed">
          {t('footer.desc')}
        </p>
        <div class="flex items-center gap-2 pt-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-green-100 dark:bg-green-950/60 text-green-700 dark:text-green-300 border border-green-300 dark:border-green-800">
            <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
            {t('editor.privacyGuaranteed')}
          </span>
        </div>
      </div>

      <!-- Quick Language Navigation -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-deep-navy/80 dark:text-pale-blue/80 mb-4">
          {t('nav.language')}
        </h4>
        <ul class="grid grid-cols-2 gap-2 text-xs">
          {
            (Object.keys(languages) as Locale[]).map((loc) => {
              const href = loc === defaultLang ? '/' : `/${loc}/`;
              const isCurrent = loc === currentLang;
              return (
                <li>
                  <a
                    href={href}
                    class={`inline-flex items-center gap-1.5 transition-colors ${
                      isCurrent
                        ? 'font-bold text-vivid-blue dark:text-white'
                        : 'text-deep-navy/70 dark:text-pale-blue/70 hover:text-vivid-blue dark:hover:text-white'
                    }`}
                  >
                    <span>{languages[loc].flag}</span>
                    <span>{languages[loc].name}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>

      <!-- External Links & Support -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-deep-navy/80 dark:text-pale-blue/80 mb-4">
          Community & Links
        </h4>
        <ul class="space-y-2.5 text-xs font-medium">
          <li>
            <a
              href="https://buymeacoffee.com/kisharadilz"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-deep-navy dark:text-pale-blue hover:text-vivid-blue dark:hover:text-yellow-300 transition-colors"
            >
              <span class="w-4 h-4 rounded-full bg-coffee-yellow flex items-center justify-center text-[10px] text-deep-navy font-bold">☕</span>
              <span>{t('footer.supportBtn')}</span>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/browsercut/browsercut.github.io"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-deep-navy/70 dark:text-pale-blue/70 hover:text-vivid-blue dark:hover:text-white transition-colors"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              <span>{t('footer.github')}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-pale-blue/40 dark:border-vivid-blue/30 flex flex-col sm:flex-row items-center justify-between text-xs text-deep-navy/60 dark:text-pale-blue/60 gap-4">
      <p>© {new Date().getFullYear()} {t('footer.allRights')}</p>
      <div class="flex items-center gap-6">
        <span class="inline-flex items-center gap-1">
          <span>Powered by</span>
          <span class="font-bold text-deep-navy dark:text-white">FFmpeg.wasm</span>
        </span>
      </div>
    </div>
  </div>
</footer>
